# Synthetic LSK business integration keys. Copy to .env.business and replace secrets.
GATEWAY_API_KEY=replace-with-long-random-gateway-key
DEMO_API_KEY=replace-with-different-long-random-service-key
AWS_REGION=us-east-1
# Exact authorized Bedrock Claude model ID or inference profile; no inference if empty.
BEDROCK_MODEL_ID=
# Required to start pilot/production services, with signed JWT access tokens.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
# Separate strong secret for internal Prometheus scrapes in pilot/production.
METRICS_API_KEY=
# NEVER enable outside an isolated synthetic-data POC.
LSK_ENABLE_DEMO_WRITES=false

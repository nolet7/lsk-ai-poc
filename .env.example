# Copy to .env for local runs: cp .env.example .env
# Never commit .env. It is listed in .gitignore and .dockerignore.

# Shared secret for POST /run. Leave blank for local development only.
PLATFORM_API_KEY=

# Log level: DEBUG, INFO, WARNING, or ERROR.
PLATFORM_LOG_LEVEL=INFO

# Embedding model used for both ingestion and retrieval. Changing it rebuilds the index.
PLATFORM_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Chunks returned per question.
PLATFORM_TOP_K=4

# Writer -> Reviewer cycles allowed before a run stops without saving.
PLATFORM_MAX_REVIEW_ATTEMPTS=2

# Load the embedding model at API startup.
PLATFORM_WARMUP_MODEL=true

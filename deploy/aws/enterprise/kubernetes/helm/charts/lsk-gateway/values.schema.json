{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "image",
    "service",
    "serviceAccount",
    "env",
    "replicaCount",
    "existingSecretName"
  ],
  "properties": {
    "replicaCount": {
      "type": "integer",
      "const": 1
    },
    "existingSecretName": {
      "type": "string",
      "minLength": 1
    },
    "image": {
      "type": "object",
      "required": [
        "repository",
        "digest"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "const": "ClusterIP"
        }
      }
    },
    "env": {
      "type": "object",
      "properties": {
        "stage": {
          "const": "poc"
        },
        "enableDemoWrites": {
          "enum": [
            "false",
            false
          ]
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}

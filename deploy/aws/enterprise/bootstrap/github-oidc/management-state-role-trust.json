{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GitHubOIDCRestrictedToRepoBranchOrApprovedEnvironment",
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::001557542177:oidc-provider/token.actions.githubusercontent.com"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
          "token.actions.githubusercontent.com:sub": [
            "repo:nolet7/lsk-ai-poc:ref:refs/heads/feature/aws-enterprise-terraform",
            "repo:nolet7/lsk-ai-poc:environment:lsk-development-apply"
          ]
        }
      }
    }
  ]
}
